<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bubblu's Birthday Party Invitation</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

body{
    min-height:100vh;
    overflow:hidden;
    display:flex;
    justify-content:center;
    align-items:center;
    background:linear-gradient(-45deg,#ff6b6b,#feca57,#48dbfb,#5f27cd,#ff9ff3);
    background-size:400% 400%;
    animation:bgMove 15s ease infinite;
}

@keyframes bgMove{
    0%{background-position:0% 50%;}
    50%{background-position:100% 50%;}
    100%{background-position:0% 50%;}
}

/* Twinkling Stars */
.star{
    position:absolute;
    color:white;
    animation:twinkle 2s infinite;
    font-size:18px;
}

@keyframes twinkle{
    0%,100%{opacity:.2;transform:scale(.8);}
    50%{opacity:1;transform:scale(1.4);}
}

/* Floating Balloons */
.balloon{
    position:absolute;
    font-size:60px;
    animation:float 10s linear infinite;
}

.balloon:nth-child(1){left:5%;animation-delay:0s;}
.balloon:nth-child(2){left:20%;animation-delay:2s;}
.balloon:nth-child(3){left:80%;animation-delay:4s;}
.balloon:nth-child(4){left:92%;animation-delay:1s;}

@keyframes float{
    from{bottom:-100px;}
    to{bottom:110%;}
}

/* Invitation Card */
.card{
    width:90%;
    max-width:900px;
    background:rgba(255,255,255,0.95);
    border-radius:30px;
    padding:35px;
    text-align:center;
    box-shadow:0 15px 40px rgba(0,0,0,.25);
    position:relative;
    z-index:10;
    border:6px solid #ffd700;
}

.card::before{
    content:"🌸";
    position:absolute;
    top:10px;
    left:15px;
    font-size:45px;
}

.card::after{
    content:"🌺";
    position:absolute;
    bottom:10px;
    right:15px;
    font-size:45px;
}

h1{
    color:#ff4081;
    font-size:3rem;
    margin-bottom:10px;
}

.subtitle{
    color:#6a1b9a;
    font-size:1.4rem;
    margin-bottom:20px;
}

.cartoons{
    font-size:55px;
    margin-bottom:15px;
}

.parents{
    background:#fff3cd;
    padding:15px;
    border-radius:15px;
    margin:15px auto;
    width:85%;
    box-shadow:0 5px 10px rgba(0,0,0,.1);
}

.details{
    background:#e8f5e9;
    padding:20px;
    border-radius:15px;
    margin:20px 0;
    font-size:1.1rem;
}

.section{
    margin-top:20px;
    text-align:left;
}

.section h3{
    color:#e91e63;
    margin-bottom:10px;
}

.section ul{
    padding-left:25px;
}

.section li{
    margin-bottom:8px;
}

.footer{
    margin-top:25px;
    font-size:1.2rem;
    font-weight:bold;
    color:#444;
}

.btn{
    display:inline-block;
    margin-top:20px;
    background:#ff4081;
    color:white;
    padding:12px 30px;
    border-radius:30px;
    text-decoration:none;
    transition:.3s;
}

.btn:hover{
    background:#d81b60;
    transform:scale(1.05);
}

.flower{
    position:absolute;
    font-size:35px;
    animation:spin 8s linear infinite;
}

.fl1{top:20px;right:20px;}
.fl2{bottom:20px;left:20px;}

@keyframes spin{
    from{transform:rotate(0deg);}
    to{transform:rotate(360deg);}
}
</style>
</head>

<body>

<!-- Floating Balloons -->
<div class="balloon">🎈</div>
<div class="balloon">🎈</div>
<div class="balloon">🎈</div>
<div class="balloon">🎈</div>

<!-- Twinkling Stars -->
<div class="star" style="top:10%;left:15%;">⭐</div>
<div class="star" style="top:20%;left:80%;">✨</div>
<div class="star" style="top:8%;left:60%;">⭐</div>
<div class="star" style="top:75%;left:10%;">✨</div>
<div class="star" style="top:85%;left:85%;">⭐</div>
<div class="star" style="top:60%;left:92%;">✨</div>
<div class="star" style="top:40%;left:5%;">⭐</div>

<!-- Invitation Card -->
<div class="card">

    <div class="flower fl1">🌷</div>
    <div class="flower fl2">🌹</div>

    <div class="cartoons">
        🧸 🎂 🎁 🎉 🐻
    </div>

    <h1>🎂 Bubblu's Birthday Party 🎂</h1>

    <p class="subtitle">
        You Are Cordially Invited To Celebrate A Magical Day Filled With Fun, Food & Happiness
    </p>

    <div class="parents">
        <h3>Hosted By</h3>
        <p><strong>Father:</strong> Sk. Riyazuddin</p>
        <p><strong>Mother:</strong> Sk. Firoze</p>
    </div>

    <div class="details">
        <p><strong>📅 Date:</strong> 15 October 2026</p>
        <p><strong>⏰ Time:</strong> 5:00 PM – 10:00 PM</p>
        <p><strong>📍 Venue:</strong> Grand Celebration Hall, Sunshine Gardens, Nellore</p>
    </div>

    <div class="section">
        <h3>🎭 Cultural Activities</h3>
        <ul>
            <li>Traditional Dance Performances</li>
            <li>Live Music & Singing</li>
            <li>Magic Show</li>
            <li>Kids Fancy Dress Competition</li>
            <li>Talent Showcase</li>
        </ul>
    </div>

    <div class="section">
        <h3>🍽️ Delicious Multi-Cuisine Feast</h3>
        <ul>
            <li>🍛 Indian Special Biryani & Curries</li>
            <li>🍜 Chinese Noodles & Fried Rice</li>
            <li>🍕 Italian Pizza & Pasta</li>
            <li>🌮 Mexican Tacos & Nachos</li>
            <li>🍰 Birthday Cake, Ice Cream & Desserts</li>
        </ul>
    </div>

    <div class="section">
        <h3>🎮 Fun Games & Entertainment</h3>
        <ul>
            <li>🎵 Musical Chairs</li>
            <li>🎯 Ring Toss</li>
            <li>🎈 Balloon Burst Challenge</li>
            <li>🗺️ Treasure Hunt</li>
            <li>💃 Dance Competition</li>
            <li>🏃 Kids Obstacle Race</li>
            <li>🎁 Lucky Draw</li>
        </ul>
    </div>

    <div class="footer">
        ✨ Let's Make Bubblu's Birthday Celebration Unforgettable! ✨
        <br><br>
        We Look Forward To Celebrating With You ❤️
    </div>

    <a href="#" class="btn">🎉 Join The Celebration 🎉</a>

</div>

</body>
</html>