<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Delicious Restaurant</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f8f8f8;
        }

        header {
            background: #333;
            color: white;
            text-align: center;
            padding: 25px;
        }

        nav {
            background: #222;
            text-align: center;
            padding: 12px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 15px;
            font-size: 18px;
        }

        .container {
            width: 90%;
            max-width: 1000px;
            margin: 30px auto;
        }

        h2 {
            text-align: center;
            margin-bottom: 25px;
            color: #333;
        }

        .menu {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
        }

        .item {
            background: white;
            padding: 20px;
            text-align: center;
            border-radius: 10px;
            box-shadow: 0 2px 8px #ccc;
        }

        .item h3 {
            color: #e67e22;
            margin-bottom: 10px;
        }

        .price {
            font-weight: bold;
            margin: 10px;
        }

        button {
            background: #e67e22;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
        }

        button:hover {
            background: #d35400;
        }

        footer {
            margin-top: 40px;
            background: #333;
            color: white;
            text-align: center;
            padding: 20px;
        }
    </style>
</head>

<body>

    <header>
        <h1>🍴 Delicious Restaurant</h1>
        <p>Fresh Food • Great Taste • Best Price</p>
    </header>

    <nav>
        <a href="#home">Home</a>
        <a href="#menu">Menu</a>
        <a href="#contact">Contact</a>
    </nav>

    <div class="container" id="menu">
        <h2>Our Menu</h2>

        <div class="menu">

            <div class="item">
                <h3>🍕 Pizza</h3>
                <p>Cheesy vegetable pizza</p>
                <p class="price">₹199</p>
                <button onclick="order('Pizza')">Order Now</button>
            </div>

            <div class="item">
                <h3>🍔 Burger</h3>
                <p>Fresh crispy chicken burger</p>
                <p class="price">₹149</p>
                <button onclick="order('Burger')">Order Now</button>
            </div>

            <div class="item">
                <h3>🍝 Pasta</h3>
                <p>Creamy Italian pasta</p>
                <p class="price">₹179</p>
                <button onclick="order('Pasta')">Order Now</button>
            </div>

            <div class="item">
                <h3>🍛 Biryani</h3>
                <p>Special chicken biryani</p>
                <p class="price">₹249</p>
                <button onclick="order('Biryani')">Order Now</button>
            </div>

            <div class="item">
                <h3>🥤 Cold Drink</h3>
                <p>Chilled refreshing drink</p>
                <p class="price">₹60</p>
                <button onclick="order('Cold Drink')">Order Now</button>
            </div>

            <div class="item">
                <h3>🍰 Cake</h3>
                <p>Fresh chocolate cake</p>
                <p class="price">₹120</p>
                <button onclick="order('Cake')">Order Now</button>
            </div>

        </div>
    </div>

    <footer id="contact">
        <p>📞 Contact: 9876543210</p>
        <p>© 2026 Delicious Restaurant</p>
    </footer>

