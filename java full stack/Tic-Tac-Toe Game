<!DOCTYPE html>
<html>
<head>
    <title>Tic Tac Toe</title>

    <style>
        body {
            text-align: center;
            font-family: Arial;
            background: #f2f2f2;
        }

        h1 {
            margin-top: 30px;
        }

        #game {
            width: 306px;
            margin: 30px auto;
            display: grid;
            grid-template-columns: repeat(3, 100px);
            gap: 3px;
        }

        .cell {
            width: 100px;
            height: 100px;
            background: white;
            border: 1px solid #333;
            font-size: 40px;
            cursor: pointer;
        }

        .cell:hover {
            background: #eee;
        }

        #message {
            font-size: 20px;
            margin: 20px;
            font-weight: bold;
        }

        button {
            padding: 10px 20px;
            font-size: 16px;
            cursor: pointer;
        }
    </style>
</head>

<body>

    <h1>🎮 Tic Tac Toe</h1>

    <div id="game">
        <button class="cell" onclick="play(0)"></button>
        <button class="cell" onclick="play(1)"></button>
        <button class="cell" onclick="play(2)"></button>

        <button class="cell" onclick="play(3)"></button>
        <button class="cell" onclick="play(4)"></button>
        <button class="cell" onclick="play(5)"></button>

        <button class="cell" onclick="play(6)"></button>
        <button class="cell" onclick="play(7)"></button>
        <button class="cell" onclick="play(8)"></button>
    </div>

    <div id="message">Player X's Turn</div>

    <button onclick="restart()">Restart Game</button>

    <script>
        let board = ["", "", "", "", "", "", "", "", ""];
        let currentPlayer = "X";
        let gameOver = false;

        const cells = document.querySelectorAll(".cell");
        const message = document.getElementById("message");

        function play(index) {

            if (board[index] !== "" || gameOver) {
                return;
            }

            board[index] = currentPlayer;
            cells[index].textContent = currentPlayer;

            if (checkWinner()) {
                message.textContent = "🎉 Player " + currentPlayer + " Wins!";
                gameOver = true;
                return;
            }

            if (!board.includes("")) {
                message.textContent = "🤝 Game Draw!";
                gameOver = true;
                return;
            }

            currentPlayer = currentPlayer === "X" ? "O" : "X";
            message.textContent = "Player " + currentPlayer + "'s Turn";
        }

        function checkWinner() {

            const winningPatterns = [
                [0, 1, 2],
                [3, 4, 5],
                [6, 7, 8],
                [0, 3, 6],
                [1, 4, 7],
                [2, 5, 8],
                [0, 4, 8],
                [2, 4, 6]
            ];

            return winningPatterns.some(pattern => {
                const [a, b, c] = pattern;

                return board[a] &&
                       board[a] === board[b] &&
                       board[a] === board[c];
            });
        }

        function restart() {
            board = ["", "", "", "", "", "", "", "", ""];
            currentPlayer = "X";
            gameOver = false;

            cells.forEach(cell => {
                cell.textContent = "";
            });

            message.textContent = "Player X's Turn";
        }
    </script>

</body>
</html> 